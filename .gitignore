# Rust
services/orchestrator/target/

# Node / Next.js
apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.env*.local

# forentend (Vite target frontend)
forentend/node_modules/
forentend/dist/

# Python
services/workers/__pycache__/
services/workers/**/__pycache__/
services/workers/.venv/
*.pyc
executors/pytest/__pycache__/
executors/pytest/.pytest_cache/
executors/schemathesis/.hypothesis/
executors/schemathesis/.schemathesis/

# Executors (npx-installed, test-run output)
executors/*/node_modules/
executors/playwright/test-results/

# Infra
infra/.env

# Secrets: local env file loaded by start.bat (MJ_AI_API_KEY etc.) — never commit
/.env

# Runtime data: the orchestrator's SQLite store and locally-captured evidence
# blobs (see services/orchestrator/src/store.rs and evidence.rs) — generated
# at runtime, not source.
infra/data/*.sqlite3
infra/data/*.sqlite3-*
infra/data/evidence/*
!infra/data/evidence/.gitkeep

# Real SKILL.md files a user drops into the backend's filesystem skills
# folder (see services/orchestrator/src/skill_files.rs) — a personal/local
# skill library, not this repo's source. The folder itself, and the README
# `ensure_skills_dir()` generates in it at startup, stay out of git too;
# only the placeholder keeping the empty directory real is tracked.
services/orchestrator/skills/*
!services/orchestrator/skills/.gitkeep

# OS
.DS_Store
Thumbs.db

# Pre-audit runtime DB snapshots (local only)
infra/data/*.preaudit
infra/data/*.bak-preaudit

# Logs and scratch
orch.log
*.log
brain/
Doc2/
*.csv
file_list.txt
errors_out.json
mocks_out.json
secrets_out.json
generate_*.py

